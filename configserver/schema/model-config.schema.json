{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://flowcanvas.local/schemas/model-config.schema.json",
    "title": "Flow Canvas 模型能力 CONFIG",
    "description": "远端下发的模型能力配置。只校验客户端真正消费的字段；其余字段一律放行，保证服务端可以先于旧客户端增加字段而不被拒绝。",
    "type": "object",
    "required": ["schemaVersion", "models"],
    "properties": {
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "revision": { "type": "integer", "minimum": 0 },
        "updatedAt": { "type": "string" },
        "source": { "type": "string" },
        "catalogMode": { "enum": ["fallback", "remote"] },
        "defaultModels": {
            "type": "object", "additionalProperties": false,
            "properties": {
                "video": { "type": "string", "minLength": 1, "maxLength": 200 },
                "image": { "type": "string", "minLength": 1, "maxLength": 200 },
                "text": { "type": "string", "minLength": 1, "maxLength": 200 }
            }
        },
        "catalogScope": {
            "type": "object", "additionalProperties": false,
            "required": ["hosts", "kinds"],
            "properties": {
                "hosts": { "$ref": "#/definitions/priceHosts" },
                "kinds": {
                    "type": "array", "minItems": 1, "uniqueItems": true,
                    "items": { "enum": ["image", "video", "text"] }
                }
            }
        },
        "refreshIntervalMs": { "type": "integer", "minimum": 60000, "maximum": 86400000 },
        "kinds": { "$ref": "#/definitions/labels" },
        "fields": { "$ref": "#/definitions/fieldVocabulary" },
        "capabilities": { "$ref": "#/definitions/capabilityVocabulary" },
        "models": {
            "type": "array",
            "minItems": 0,
            "items": { "$ref": "#/definitions/model" }
        }
    },
    "definitions": {
        "labels": {
            "type": "object",
            "additionalProperties": { "type": "string" }
        },
        "stringList": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
        },
        "paramNames": {
            "oneOf": [
                { "type": "string", "minLength": 1 },
                { "$ref": "#/definitions/stringList" }
            ]
        },
        "fieldVocabulary": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "required": ["label", "param"],
                "properties": {
                    "label": { "type": "string", "minLength": 1 },
                    "param": { "$ref": "#/definitions/paramNames" },
                    "type": {
                        "enum": ["text", "enum", "range", "duration", "tier", "boolean", "references", "unknown"]
                    },
                    "nodeKey": { "type": "string" },
                    "note": { "type": "string" }
                }
            }
        },
        "capabilityVocabulary": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "required": ["label"],
                "properties": {
                    "label": { "type": "string", "minLength": 1 },
                    "fields": { "$ref": "#/definitions/stringList" },
                    "kind": { "enum": ["image", "video", "text"] },
                    "kinds": {
                        "type": "array",
                        "items": { "enum": ["image", "video", "text"] },
                        "minItems": 1
                    },
                    "implies": { "$ref": "#/definitions/stringList" },
                    "note": { "type": "string" }
                }
            }
        },
        "constraint": {
            "oneOf": [
                {
                    "type": "object",
                    "required": ["type", "values"],
                    "properties": {
                        "type": { "const": "enum" },
                        "values": { "type": "array", "minItems": 1 },
                        "default": {},
                        "allowAuto": { "type": "boolean" },
                        "labels": { "$ref": "#/definitions/labels" },
                        "field": { "type": "string" },
                        "note": { "type": "string" }
                    }
                },
                {
                    "type": "object",
                    "required": ["type", "min", "max"],
                    "properties": {
                        "type": { "const": "range" },
                        "min": { "type": "number" },
                        "max": { "type": "number" },
                        "integer": { "type": "boolean" },
                        "step": { "type": "number" },
                        "default": { "type": "number" },
                        "field": { "type": "string" },
                        "note": { "type": "string" }
                    }
                },
                {
                    "type": "object",
                    "required": ["type", "value"],
                    "properties": {
                        "type": { "const": "fixed" },
                        "value": {},
                        "unit": { "type": "string" },
                        "field": { "type": "string" },
                        "note": { "type": "string" }
                    }
                },
                {
                    "type": "object",
                    "required": ["type", "values"],
                    "properties": {
                        "type": { "const": "tier" },
                        "values": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                        "default": { "type": "string" },
                        "encode": { "enum": ["dimensions", "tier"] },
                        "field": { "type": "string" },
                        "note": { "type": "string" }
                    }
                },
                {
                    "type": "object",
                    "required": ["type"],
                    "properties": {
                        "type": { "const": "unknown" },
                        "reason": { "type": "string" },
                        "field": { "type": "string" },
                        "note": { "type": "string" }
                    }
                },
                {
                    "type": "object",
                    "required": ["type"],
                    "properties": {
                        "type": { "const": "unsupported" },
                        "reason": { "type": "string" },
                        "field": { "type": "string" },
                        "note": { "type": "string" }
                    }
                }
            ]
        },
        "parameterRuleScalar": {
            "oneOf": [
                { "type": "number", "minimum": -1000000, "maximum": 1000000 },
                { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_.:+/-]+$" }
            ]
        },
        "parameterRuleConstraint": {
            "type": "object", "additionalProperties": false, "required": ["type"],
            "properties": {
                "type": { "enum": ["range", "fixed", "enum"] },
                "min": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
                "max": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
                "integer": { "type": "boolean" },
                "step": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 },
                "default": { "$ref": "#/definitions/parameterRuleScalar" },
                "allowAuto": { "type": "boolean" },
                "value": { "$ref": "#/definitions/parameterRuleScalar" },
                "values": { "type": "array", "minItems": 1, "maxItems": 120, "uniqueItems": true,
                    "items": { "$ref": "#/definitions/parameterRuleScalar" } }
            },
            "allOf": [
                { "if": { "properties": { "type": { "const": "range" } } }, "then": { "required": ["min", "max"] } },
                { "if": { "properties": { "type": { "const": "fixed" } } }, "then": { "required": ["value"] } },
                { "if": { "properties": { "type": { "const": "enum" } } }, "then": { "required": ["values"] } }
            ]
        },
        "parameterRuleOptions": {
            "type": "object", "additionalProperties": false, "minProperties": 1,
            "properties": {
                "resolutionTier": { "$ref": "#/definitions/parameterRuleConstraint" },
                "ratio": { "$ref": "#/definitions/parameterRuleConstraint" },
                "duration": { "$ref": "#/definitions/parameterRuleConstraint" },
                "quality": { "$ref": "#/definitions/parameterRuleConstraint" },
                "n": { "$ref": "#/definitions/parameterRuleConstraint" }
            }
        },
        "parameterRuleReference": {
            "type": "object", "additionalProperties": false, "required": ["supported"],
            "properties": {
                "supported": { "type": "boolean" },
                "min": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
                "max": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
                "maxBytesPerImage": { "type": "integer", "minimum": 0, "maximum": 1073741824 }
            }
        },
        "parameterRules": {
            "type": "object", "additionalProperties": false, "required": ["version", "rules"],
            "properties": {
                "version": { "type": "integer", "minimum": 1 },
                "rules": {
                    "type": "array", "maxItems": 64,
                    "items": {
                        "type": "object", "additionalProperties": false, "required": ["when"],
                        "anyOf": [{ "required": ["options"] }, { "required": ["capabilities"] }],
                        "properties": {
                            "when": {
                                "type": "object", "additionalProperties": false, "minProperties": 1,
                                "properties": {
                                    "resolutionTier": { "$ref": "#/definitions/parameterRuleScalar" },
                                    "ratio": { "$ref": "#/definitions/parameterRuleScalar" },
                                    "duration": { "$ref": "#/definitions/parameterRuleScalar" },
                                    "quality": { "$ref": "#/definitions/parameterRuleScalar" },
                                    "n": { "$ref": "#/definitions/parameterRuleScalar" }
                                }
                            },
                            "options": { "$ref": "#/definitions/parameterRuleOptions" },
                            "capabilities": {
                                "type": "object", "additionalProperties": false, "minProperties": 1,
                                "properties": {
                                    "referenceImages": { "$ref": "#/definitions/parameterRuleReference" },
                                    "referenceVideos": { "$ref": "#/definitions/parameterRuleReference" },
                                    "referenceAudios": { "$ref": "#/definitions/parameterRuleReference" }
                                }
                            }
                        }
                    }
                }
            }
        },
        "capability": {
            "type": "object",
            "required": ["supported"],
            "properties": {
                "supported": { "type": "boolean" },
                "max": { "type": "integer", "minimum": 0 },
                "min": { "type": "integer", "minimum": 0 },
                "maxBytesPerImage": { "type": "integer", "minimum": 1 },
                "maxLength": { "type": "integer", "minimum": 1 },
                "note": { "type": "string" },
                "reason": { "type": "string" },
                "params": { "$ref": "#/definitions/stringList" }
            }
        },
        "presentation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "label": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S" },
                "description": { "type": "string", "maxLength": 500 },
                "routeLabel": { "type": "string", "maxLength": 80 },
                "routeGroup": { "type": "string", "maxLength": 100 },
                "routeGroupLabel": { "type": "string", "maxLength": 100 },
                "routeGroupDescription": { "type": "string", "maxLength": 500 },
                "routeGroupOrder": { "type": "integer", "minimum": -100000, "maximum": 100000 },
                "routeOrder": { "type": "integer", "minimum": -100000, "maximum": 100000 },
                "routeGroupAlways": { "type": "boolean" },
                "routeGroupScope": { "enum": ["provider", "catalog"] },
                "visible": { "type": "boolean" },
                "routeModelLabel": { "type": "string", "maxLength": 100 },
                "recommended": { "type": "boolean" }
            }
        },
        "priceHosts": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "maxLength": 253, "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" }
        },
        "pricing": {
            "oneOf": [
                {
                    "type": "object", "additionalProperties": false,
                    "required": ["status", "hosts"],
                    "properties": {
                        "status": { "const": "unknown" },
                        "hosts": { "$ref": "#/definitions/priceHosts" }
                    }
                },
                {
                    "type": "object", "additionalProperties": false,
                    "required": ["status", "hosts", "amount", "currency", "unit", "kind", "source", "updatedAt"],
                    "properties": {
                        "status": { "const": "known" },
                        "hosts": { "$ref": "#/definitions/priceHosts" },
                        "amount": { "type": "number", "minimum": 0, "maximum": 1000000 },
                        "currency": { "enum": ["CNY", "USD"] },
                        "unit": { "enum": ["request", "image", "second"] },
                        "kind": { "const": "sale" },
                        "source": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
                        "updatedAt": { "type": "string", "format": "date-time" }
                    }
                }
            ]
        },
        "salePrices": {
            "type": "array", "maxItems": 2, "uniqueItems": true,
            "items": { "$ref": "#/definitions/siteSalePrice" },
            "if": { "minItems": 2 },
            "then": {
                "allOf": [
                    { "contains": { "properties": { "host": { "const": "art.ravenhash.org" } } } },
                    { "contains": { "properties": { "host": { "const": "cart.ravenhash.org" } } } }
                ]
            }
        },
        "siteSalePrice": {
            "type": "object", "additionalProperties": false,
            "required": ["host", "status", "currency", "kind", "source", "updatedAt", "prices"],
            "properties": {
                "host": { "enum": ["art.ravenhash.org", "cart.ravenhash.org"] },
                "status": { "enum": ["known", "unknown"] },
                "currency": { "enum": ["CNY", "USD"] },
                "kind": { "const": "sale" },
                "source": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
                "updatedAt": { "type": "string", "format": "date-time" },
                "note": { "type": "string", "maxLength": 2000 },
                "prices": {
                    "type": "array", "maxItems": 100,
                    "items": {
                        "type": "object", "additionalProperties": false,
                        "required": ["label", "amount", "unit"],
                        "properties": {
                            "label": { "type": "string", "maxLength": 200 },
                            "amount": { "type": "number", "minimum": 0 },
                            "unit": { "enum": ["request", "second", "image", "million_tokens"] }
                        }
                    }
                }
            },
            "if": { "properties": { "status": { "const": "known" } } },
            "then": { "properties": { "prices": { "minItems": 1 } } }
        },
        "model": {
            "type": "object",
            "required": ["id", "kind", "match"],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "label": { "type": "string" },
                "presentation": { "$ref": "#/definitions/presentation" },
                "catalog": {
                    "type": "object", "additionalProperties": false,
                    "required": ["model", "hosts"],
                    "properties": {
                        "model": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^\\S+$" },
                        "hosts": { "$ref": "#/definitions/priceHosts" },
                        "enabled": { "type": "boolean" }
                    }
                },
                "pricing": { "$ref": "#/definitions/pricing" },
                "salePrices": { "$ref": "#/definitions/salePrices" },
                "kind": { "enum": ["image", "video", "text"] },
                "channel": { "type": "string" },
                "route": { "type": "string" },
                "priority": { "type": "integer" },
                "match": {
                    "type": "object",
                    "required": ["model"],
                    "properties": {
                        "model": { "$ref": "#/definitions/stringList" },
                        "endpoint": { "type": "string" },
                        "channel": { "type": "string" }
                    }
                },
                "parameters": {
                    "type": "object",
                    "properties": {
                        "accepts": { "$ref": "#/definitions/stringList" },
                        "required": { "$ref": "#/definitions/stringList" }
                    }
                },
                "parameterRules": { "$ref": "#/definitions/parameterRules" },
                "options": {
                    "type": "object",
                    "additionalProperties": { "$ref": "#/definitions/constraint" }
                },
                "capabilities": {
                    "type": "object",
                    "additionalProperties": { "$ref": "#/definitions/capability" }
                },
                "prompt": {
                    "type": "object",
                    "properties": {
                        "required": { "type": "boolean" },
                        "maxLength": { "type": "integer", "minimum": 1 },
                        "note": { "type": "string" }
                    }
                },
                "limits": {
                    "type": "object",
                    "additionalProperties": true
                },
                "notes": { "type": "string" }
            }
        }
    }
}
